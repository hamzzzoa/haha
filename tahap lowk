-- ═══════════ BUILD GUI ═══════════
local function buildGUI()
    local sg = Instance.new("ScreenGui")
    sg.Name = "ToF_Aimlock_Survivor"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.Parent = LP:WaitForChild("PlayerGui")

    -- FOV Circle
    local fov = Instance.new("Frame")
    fov.Name = "FOVCircle"
    fov.AnchorPoint = Vector2.new(0.5, 0.5)
    fov.Position = UDim2.new(0.5, 0, 0.5, 0)
    fov.Size = UDim2.new(0, Config.FOVRadius * 2, 0, Config.FOVRadius * 2)
    fov.BackgroundTransparency = 1
    fov.Parent = sg

    Instance.new("UICorner", fov).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke", fov)
    stroke.Color = Config.FOVColor
    stroke.Thickness = 1.5
    stroke.Transparency = 0.35

    -- Hold Button
    local btn = Instance.new("TextButton")
    btn.Name = "HoldBtn"
    btn.AnchorPoint = Vector2.new(1, 0.5)
    btn.Position = UDim2.new(1, -30, 0.5, 0)
    btn.Size = UDim2.new(0, 130, 0, 130)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.Text = "🎯 HOLD\nAIM LOCK"
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Parent = sg

    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    local bstroke = Instance.new("UIStroke", btn)
    bstroke.Color = Config.FOVColor
    bstroke.Thickness = 2
    bstroke.Parent = btn

    return sg, fov, btn, stroke, bstroke
end

local ScreenGui, FOVFrame, HoldBtn, FOVStroke, BtnStroke = buildGUI()

