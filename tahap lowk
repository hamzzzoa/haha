-- ═══════════ HELPERS ═══════════
local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getRoot(plr)
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function sameTeam(plr)
    if not Config.TeamCheck then return false end
    return plr.Team ~= nil and plr.Team == LP.Team
end

-- Cari target terdekat dari mouse dalam FOV
local function findTarget()
    local best, bestDist = nil, Config.FOVRadius
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and (not Config.IgnoreDead or isAlive(plr)) and not sameTeam(plr) then
            local root = getRoot(plr)
            if root then
                local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = plr
                    end
                end
            end
        end
    end

    return best
end

-- Hitung posisi aim (Auto Height + Divider + Predict)
local function calculateAimPos(target)
    local root = getRoot(target)
    if not root then return nil end

    local pos = root.Position

    -- Auto Height → aim ke Head
    if Config.AutoHeight then
        local head = target.Character:FindFirstChild("Head")
        if head then
            pos = head.Position
        end
    end

    -- Divider adjustment
    pos = pos + Vector3.new(0, Config.Divider * 0.05, 0)

    -- Aim Prediction
    if Config.AimPredict then
        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            local velocity = hum.MoveDirection * hum.WalkSpeed
            pos = pos + (velocity * Config.PredictStrength)
        end
    end

    return pos
end

-- ═══════════ MAIN LOOP ═══════════
RunService.RenderStepped:Connect(function()
    -- Update FOV circle
    FOVFrame.Visible = Config.ShowFOV
    if Config.ShowFOV then
        local size = Config.FOVRadius * 2
        FOVFrame.Size = UDim2.new(0, size, 0, size)
        FOVStroke.Color = Config.FOVColor
    end

    -- Cek aktivasi aimlock
    local active = isHolding or UserInputService:IsMouseButtonPressed(Config.LockKey)
    if not active then return end

    local target = findTarget()
    if not target then return end

    local aimPos = calculateAimPos(target)
    if not aimPos then return end

    -- Smooth camera rotation ke target
    local currentCF = Camera.CFrame
    local targetCF  = CFrame.new(currentCF.Position, aimPos)
    Camera.CFrame  = currentCF:Lerp(targetCF, Config.Smoothness)
end)

-- ═══════════ NOTIFIKASI ═══════════
local function notify(text, dur)
    dur = dur or 4
    local g = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true

    local lbl = Instance.new("TextLabel", g)
    lbl.AnchorPoint = Vector2.new(0.5, 0)
    lbl.Position = UDim2.new(0.5, 0, 0, 30)
    lbl.Size = UDim2.new(0, 460, 0, 55)
    lbl.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    lbl.BackgroundTransparency = 0.15
    lbl.TextColor3 = Config.FOVColor
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.Text = text
    lbl.Parent = g

    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 10)
    local s = Instance.new("UIStroke", lbl)
    s.Color = Config.FOVColor
    s.Thickness = 1.5
    s.Parent = lbl

    task.wait(dur)
    g:Destroy()
end

